<?xml version="1.0" encoding="utf-8"?>
<!-- Android shell for the port: SDL3's SDLActivity running libmain.so (android/CMakeLists.txt). No game files are
     included; the player copies their own prepared game into Android/data/dev.dcpport.android/files. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.dcpport.android"
    android:versionCode="1"
    android:versionName="0.9.2-android1">

    <uses-feature android:glEsVersion="0x00020000" />
    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x403000" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Online play: the lobby (wss://) and the direct UDP connections between players. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- DcpActivity's power notice opens Samsung's Game Launcher (bypass charging) when it is installed. -->
    <queries>
        <package android:name="com.samsung.android.game.gamehome" />
    </queries>

    <application
        android:label="DCP Port"
        android:debuggable="true"
        android:hardwareAccelerated="true"
        android:extractNativeLibs="true"
        android:appCategory="game"
        android:isGame="true"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen">
        <activity
            android:name=".DcpActivity"
            android:exported="true"
            android:label="DCP Port"
            android:alwaysRetainTaskState="true"
            android:launchMode="singleInstance"
            android:screenOrientation="sensorLandscape"
            android:configChanges="layoutDirection|locale|grammaticalGender|fontScale|fontWeightAdjustment|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:preferMinimalPostProcessing="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
